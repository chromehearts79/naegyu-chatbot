# macOS
.DS_Store

# 비밀값 (API 키 등)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node
node_modules/

# 변환본은 준비 스크립트로 다시 만든다
data/

# 이름이 [ 로 시작하는 파일(지난판·참고 자료)은 올리지 않는다
원본/**/[[]*
대기/**/[[]*

# 담당자 연락처와 그 보고서: 개인정보라 올리지 않는다
knowledge/contacts.json
reports/contacts/
scripts/contacts_report.py

# 질문 로그: 직원이 입력한 개인정보가 섞일 수 있다
logs/
*.log

# 빌드 결과: scripts/build_web.py 로 다시 만든다
dist/

# 개정 반영 도구가 단계마다 쓰는 임시 결과(update_rules.py)
reports/update/
