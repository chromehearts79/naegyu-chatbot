    return h("button", { class: "linkish", type: "button", text: n.rule + " (" + n.articles + "개 조)", onclick: function () { if (body) body.pick(n.rule); } });
  }))));
  if (res.foldN) {
    var eg = folds.slice(0, 2).map(function (g) { return "‘" + g.key + "’ " + g.n + "곳"; }).join(", ");
    head.append(h("p", { class: "soft", text: "다른 낱말 속에서 걸린 " + res.foldN + "곳" + (eg ? "(" + eg + ")" : "") + "은 접어 두었습니다." +
      (res.mode === "phrase" ? " 아래 ‘다른 낱말 속’ 단추를 누르면 함께 봅니다." : "") }));
  }
  var simEntries = [], simTitle = "";
  if (nExact || res.aliases.length) {
    // 줄여 부르는 말: 내규가 둘 이하면 어디서 정했는지까지, 많으면("우체국금융개발원" → 거의 모든 내규의 ‘금융원’) 한 줄로
    if (res.aliases.length) {
      var aw = res.aliases.map(function (a) { return a.alias; }).filter(function (x, i, arr) { return arr.indexOf(x) === i; });
      head.append(h("p", { class: "soft", text: "줄여 부르는 말 " + aw.map(function (x) { return "‘" + x + "’"; }).join(", ") + "도 함께 찾았습니다(" +
        (res.aliases.length <= 2 ? res.aliases.map(function (a) { return a.rule + " " + a.at; }).join(", ") + "에서 정함" : "내규 " + res.aliases.length + "개가 각각 정함") + ")." }));
    }
    if (nExact > 100) head.append(h("p", { class: "soft", text: "많이 나오는 낱말입니다. 띄어 쓰고 낱말을 하나 더 넣으면 둘 다 나오는 곳만 보여 줍니다." }));
  } else {
    head.append(h("p", { class: "caution", text: res.foldN ? "내규 " + DATA.rules.length + "개 원문에 낱말 그대로 나오는 곳은 없고, 다른 낱말 속에서만 걸립니다: " + shown : "내규 " + DATA.rules.length + "개 원문에 글자 그대로 나오는 곳이 없습니다: " + shown }));
    if (res.simWords.length) head.append(h("p", { text: "원문에서 쓰는 말로 바꿔 찾았습니다: " + res.simWords.map(function (s) { return "‘" + s.word + "’"; }).join(", ") }));
    res.outside.forEach(function (o) {
      head.append(h("p", { class: "caution" }, ["‘" + o.title.replace(/\s*\(내규에 없음\)$/, "") + "’: 내규에 정한 내용이 없습니다(챗봇 답 기준). ",
        h("button", { class: "linkish", type: "button", text: "챗봇 답 보기", onclick: function () { pick(byId.get(o.id)); } })]));
    });
    var simAll = res.simWords.map(function (s) { return s.word; });
    if (res.similar.length) {
      simEntries = res.similar.map(function (g) {
        var quotes = {}, whys = [];
        g.hits.forEach(function (x) {
          // 근거 문구는 답 카드로만 찾은 조문에 표시한다(바꿔 찾은 말이 있는 조문은 그 말을 표시)
          if (x.quotes.length && !x.words.length) quotes[x.no] = x.quotes[0];
          if (whys.indexOf(x.why) < 0) whys.push(x.why);
        });
        return { rule: g.rule, n: g.n, hits: g.hits, hit: [], sim: simAll, quotes: quotes, whys: whys };
      });
      simTitle = "비슷한 말·관련 답으로 찾은 내규 · " + simEntries.length + "개 · 참고용";
    } else if (res.related.length) {
      var byR = {};
      res.related.forEach(function (x) { (byR[x.rule] = byR[x.rule] || []).push(x); });
      simEntries = Object.keys(byR).map(function (rule) { return { rule: rule, n: byR[rule].length, hits: byR[rule], hit: [], sim: [], whys: ["글자가 비슷한 조문(참고)"] }; });
      simTitle = "글자가 비슷한 조문이 있는 내규 · 참고용";
    }
    if (!simEntries.length && !res.outside.length && !res.foldN) head.append(h("p", { class: "soft", text: "비슷한 곳도 찾지 못했습니다. 내규에 정한 내용이 없을 수 있으니 관련 부서에 문의하세요. 다른 낱말로 찾아보셔도 됩니다." }));
  }
  // 켠 묶음으로 걸린 곳이 있는 조문만, 많이 나오는 순(줄인 말 포함). 한 내규 안의 찾은 조문은 원문 순서대로
  function literalEntries() {
    var per = {}, at0 = {};
    DATA.rules.forEach(function (r, i) { at0[r.name] = i; });
    // 원문 칸에서 꺼 둔 곳을 점선으로 그리려고, 목록에 넣지 않는 조문(꺼 둔 곳만 있음)의 걸린 곳도 넘긴다
    var occ = {};
    res.exact.concat(res.folded).forEach(function (g) {
      g.hits.forEach(function (x) { (occ[g.rule] = occ[g.rule] || {})[x.no] = new Map(x.occ.map(function (o) { return [o.at, isOn(o)]; })); });
    });
    res.exact.concat(res.folded).forEach(function (g) {
      g.hits.forEach(function (x) {
        if (res.mode === "all" ? !x.count : !x.occ.some(isOn)) return;
        (per[g.rule] = per[g.rule] || { hits: [], occ: occ[g.rule] }).hits.push(x);
      });
    });
    res.aliases.forEach(function (a) {
      var p = per[a.rule] = per[a.rule] || { hits: [], occ: occ[a.rule] || {} }, have = new Set(p.hits.map(function (x) { return x.no; }));
      p.hits = p.hits.concat(a.hits.filter(function (x) { return !have.has(x.no); }));
    });
    return Object.keys(per).sort(function (a, b) { return per[b].hits.length - per[a].hits.length || at0[a] - at0[b]; }).map(function (rule) {
      var r = rulesByName.get(rule), ord = {}, hits = per[rule].hits.slice();
      r.articles.forEach(function (a, i) { ord[a.no] = i; });
      r.annexes.forEach(function (x, i) { ord[x.title] = 10000 + i; });
      hits.sort(function (a, b) { return ord[a.no] - ord[b.no]; });
      return { rule: rule, n: hits.length, hits: hits, hit: words, occ: per[rule].occ, startAt: startAt[rule],
        sim: res.aliases.filter(function (a) { return a.rule === rule; }).map(function (a) { return a.alias; }) };
    });
  }
  function refresh() {
    var ent = literalEntries();
    body = ent.length ? compassBody(ent, shown + " 나오는 내규 · " + ent.length + "개 · 많이 나오는 순") : simEntries.length ? compassBody(simEntries, simTitle) : null;
    slot.replaceChildren();
    if (body) { slot.append(body.el); if (slot.isConnected) body.ready(); }
  }
  // 걸린 말별 단추(한 낱말일 때): 같은 글자 다른 뜻(이사회·이사화물)을 따로 끄고, 접어 둔 곳(개인정보 속 '인정')을 켠다
  function chipRow(label, list, cap) {
    if (!list.length) return null;
    var row = h("div", { class: "row" }, [h("span", { class: "label", text: label })]);
    var btns = list.map(function (g, i) {
      var b = h("button", { class: "gchip" + (g.main ? "" : " fold"), type: "button", "aria-pressed": on.has(gid(g)) ? "true" : "false", hidden: i >= cap ? "" : null,
        title: g.main ? "누르면 이 말로 걸린 곳을 빼고 봅니다" : "다른 낱말 속에서 걸린 곳입니다. 누르면 함께 봅니다",
        onclick: function () {
          if (on.has(gid(g))) on.delete(gid(g)); else on.add(gid(g));
          b.setAttribute("aria-pressed", on.has(gid(g)) ? "true" : "false");
          refresh();
        } }, [g.key, h("span", { text: String(g.n) })]);
      row.append(b);
      return b;
    });
    if (list.length > cap) {
      var more = h("button", { class: "more", type: "button", text: "나머지 " + (list.length - cap) + "개", onclick: function () { btns.forEach(function (b) { b.hidden = false; }); more.remove(); } });
      row.append(more);
    }
    return row;
  }
  if (res.mode === "phrase" && (res.groups.length >= 2 || folds.length)) {
    head.append(h("div", { class: "groups", role: "group", "aria-label": "걸린 말별로 켜고 끄기" },
      [chipRow("걸린 말", res.groups.filter(function (g) { return g.main; }), 8), chipRow("다른 낱말 속", folds, 6)]));
  }
  head.append(h("p", { class: "soft", text: "글자 그대로 나오는 곳은 띄어 쓴 곳까지 빠짐없이 찾고, ‘개인정보’ 속 ‘인정’처럼 다른 낱말 속에서 걸린 곳은 접어 둡니다. 비슷한 말로 찾은 곳은 참고용이니 원문을 읽고 판단하세요." }));
  var node = h("div", { class: "compass" }, [head, slot]);
  refresh();
  addTurn(text, "나침반", node);
  if (body) body.ready();
}

