      var el = form.querySelector("#" + ids[f[0]]);
      o[f[0]] = f[1] === "check" ? el.checked : f[1] === "yesno" ? el.value === "y" : el.value;
    });
    // 비었거나 덜 쓴 칸에 '확인 필요' 표시(눈에 보이는 배지 + 화면 읽기 프로그램용 필수·오류 표시)
    spec.fields.forEach(function (f) {
      if (f[1] === "check") return;
      var el = form.querySelector("#" + ids[f[0]]), st = state(f, el.value);
      var required = f[5] !== "opt" && !(spec.optional && spec.optional[f[0]] && spec.optional[f[0]](o));
      var need = (required && st === "empty") || st === "partial" || st === "bad";
      el.parentNode.classList.toggle("need", need);
      el.setAttribute("aria-required", required ? "true" : "false");
      el.setAttribute("aria-invalid", need ? "true" : "false");
      var desc = [el.dataset.hint, need ? msgId : ""].filter(Boolean).join(" ");
      if (desc) el.setAttribute("aria-describedby", desc); else el.removeAttribute("aria-describedby");
      if (need) (st === "partial" ? partial : st === "bad" ? bad : miss).push(f[2]);
    });
    if (miss.length || partial.length || bad.length) {
      var msg = [miss.length ? "‘확인 필요’ 칸(" + miss.join(", ") + ")을 채우면 계산합니다." : "",
        partial.length ? "날짜를 끝까지(연도 4자리) 넣어 주세요: " + partial.join(", ") + "." : "",
        bad.length ? "0 이상의 정수로 넣어 주세요: " + bad.join(", ") + "." : ""].filter(Boolean).join(" ");
      hold(h("p", { class: "need-msg", id: msgId, text: msg })); live.textContent = msg; return;
    }
    var r = E.calc[kind](o);
    if (r.error) { hold(h("p", { class: "err", text: r.error })); live.textContent = r.error; return; }
    live.textContent = "계산 결과: " + r.rows.slice(0, 2).map(function (row) { return row[0] + " " + row[1]; }).join(", ");
    last = h("div", null, [
      h("table", null, [h("tbody", null, r.rows.map(function (row) { return h("tr", null, [h("td", { text: row[0] }), h("td", { text: row[1] })]); }))]),
      h("div", null, (r.notes || []).map(function (n) { return h("p", { class: "soft", text: "· " + n }); }))
    ]);
    out.replaceChildren(last);
  }
  // 질문에서 읽어 넣은 값을 직원이 고치면 그 안내도 바꾼다(고친 뒤에도 '출장 일수 2'로 남아 있으면 헷갈린다)
  var filledNote = filled.length ? h("p", { class: "soft", text: "질문에서 읽어 넣었습니다(" + filled.join(", ") + "). 맞는지 확인하세요." }) : null;
  function edited() {
    if (filledNote && !filledNote.dataset.edited) { filledNote.dataset.edited = "1"; filledNote.textContent = "질문에서 읽은 값을 고쳤습니다. 지금 칸에 있는 고친 값으로 계산합니다."; }
    run();
  }
  form.addEventListener("input", edited); form.addEventListener("change", edited);
  form.addEventListener("submit", function (e) { e.preventDefault(); run(); });
  // append 에 null 을 넘기면 글자 'null'이 찍히므로, 질문에서 읽어 채운 칸이 있을 때만 안내 문단을 넣는다
  box.append(head);
  if (filledNote) box.append(filledNote);
  if (kind === "tripExpense" && vals.regionNote) box.append(h("p", { class: "soft", text: vals.regionNote }));
  box.append(form, out, live);
  run();
  return box;
}
// 계산기가 없는 답에 관련 계산기를 여는 버튼(누르면 그 자리에 계산기가 열린다)
function calcButton(kind, question) {
  var wrap = h("div", { class: "calc-link" });
  wrap.append(h("button", { class: "btn ghost", type: "button", text: "계산기 열기 · " + CALCS[kind].title, onclick: function () {
    wrap.replaceChildren(renderCalc(kind, question));
  } }));
  return wrap;
}

/* ── 답변 그리기 ─────────────────────────────── */
// 사람 검수를 마친 카드(reviewed 칸)만 '검수 완료'로 표시한다. 프로그램·AI 검사만 거친 카드는 검수 전으로 정직하게 적는다.
function statusPill(c) {
  if (c.stale) return h("span", { class: "pill warn", text: "규정 개정 · 재검수 전" });
  if (c.kind === "outside") return h("span", { class: "pill warn", text: "내규에 없는 내용" });
  if (c.reviewed) return h("span", { class: "pill ok", text: "담당부서 검수 완료 · " + c.reviewed.date + " " + c.reviewed.dept });
  return h("span", { class: "pill warn", text: "AI 작성 · 담당부서 검수 전" });
}
// 검수 메모·규정 정비 후보는 담당부서용이다. 주소 끝에 #review 를 붙여 열었을 때만 보인다.
var REVIEW = /review/.test(location.hash + location.search);
function cardButton(id, onPick) {
  var c = byId.get(id), rule = E.ruleOfCard(c);
  return h("button", { class: "cand", type: "button", onclick: function () { onPick(c); } }, [
    rule ? h("em", { class: "cand-rule", text: rule }) : null, h("b", { text: c.title }), h("span", { text: c.summary })
  ]);
}
// open 이면 처음부터 펼친다. 답의 점수가 애매할 때 다른 규정을 찾던 사람이 바로 보게 하려는 것.
function relatedHits(question, open) {
  var hits = articles().search(question, 3);
  if (!hits.length) return null;
  return h("details", { class: "box", open: open ? "" : null }, [
    h("summary", { text: (open ? "혹시 다른 규정을 찾으셨나요? " : "") + "규정 전체에서 찾은 관련 조문 " + hits.length + "건" }),
    h("div", { class: "hits" }, hits.map(hitButton.bind(null, question)))
  ]);
}
function hitButton(question, x) {
  var d = x.doc, cite = d.kind === "annex" ? d.rule + " " + d.no : d.rule + " " + d.no;
  return h("button", { class: "hit", type: "button", onclick: function () { openSource(cite, ""); } }, [
    h("b", { text: d.rule + " " + d.no + (d.title ? "(" + d.title + ")" : "") }),
    h("span", { text: E.snippet(d.text, question) })
  ]);
}
function reportBox(question, card) {
  var wrap = h("div", { class: "report", hidden: true }), id = "r" + (++calcSeq);
  var rel = (DATA.meta.site || {}).release || {};
  var text = "[내규챗봇 시범본 의견]\n질문: " + (question || "-") + "\n답변: " + (card ? card.title + " (" + card.id + ")" : "준비된 답 없음") +
    "\n판: " + (rel.no ? "제" + rel.no + "판, " : "") + DATA.meta.built + " 만듦 · 규정 기준일: " + DATA.meta.basis + "\n의견: ";
  var ta = h("textarea", { id: id, "aria-label": "보낼 의견" }); ta.value = text;
  var msg = h("span", { class: "soft" });
  // 오류 신고 창구(knowledge/site.json). 운영부서가 정해지기 전에는 정해지지 않았다고 그대로 알린다.
  var fb = (DATA.meta.site || {}).feedback || {};
  var where = fb.dept ? "보낼 곳: " + fb.dept + (fb.channel ? " (" + fb.channel + ")" : "") + (fb.email ? " · " + fb.email : "") + ". " + (fb.handling || "")
    : "오류 신고를 받을 운영부서가 아직 정해지지 않았습니다. 아래 내용을 복사해 내규챗봇 관리자에게 보내 주세요.";
  var mail = fb.email ? h("a", { class: "btn ghost", href: "mailto:" + fb.email + "?subject=" + encodeURIComponent("[내규챗봇 의견] " + (card ? card.title : "준비된 답 없음")),
    onclick: function () { this.href = "mailto:" + fb.email + "?subject=" + encodeURIComponent("[내규챗봇 의견] " + (card ? card.title : "준비된 답 없음")) + "&body=" + encodeURIComponent(ta.value); }, text: "메일로 보내기" }) : null;
  wrap.append(
    h("p", { class: "soft", text: "이 화면은 의견을 어디에도 자동으로 보내지 않습니다. " + where }),
    ta,
    h("div", { class: "chips" }, [mail, h("button", { class: "btn ghost", type: "button", text: "복사", onclick: function () {
      var done = function () { msg.textContent = "복사했습니다."; };
      try { navigator.clipboard.writeText(ta.value).then(done, function () { ta.select(); msg.textContent = "선택해 두었습니다. Ctrl+C로 복사하세요."; }); }
      catch (e) { ta.select(); msg.textContent = "선택해 두었습니다. Ctrl+C로 복사하세요."; }
    } }), msg].filter(Boolean))
  );
  return wrap;
}
function feedbackRow(question, card) {
  // '도움이 됐어요'는 아무 기록도 남기지 않아 뺐다. 틀린 답 신고만 받는다.
  var rep = reportBox(question, card);
  return [h("div", { class: "feedback" }, [
    h("span", { class: "soft", text: "답이 틀렸거나 부족하면 알려 주세요." }),
    h("button", { class: "btn ghost", type: "button", text: "오류 신고", onclick: function () { rep.hidden = !rep.hidden; } })
  ]), rep];
}

// 질문의 핵심 낱말이 준비된 답에 없을 때: 내규에 규정이 없을 수 있다고 분명히 알린다
function missingNote(words) {
  return h("p", { class: "caution", text: "질문의 " + words.map(function (w) { return "‘" + w + "’"; }).join(", ") +
    "에 맞는 내용은 준비된 답에서 찾지 못했습니다. 내규에 직접 정한 내용이 없을 수 있으니, 아래 내용이 맞지 않으면 관련 부서에 문의하세요." });
}
function renderAnswer(c, opts) {
  opts = opts || {};
  var a = h("article", { class: "a" });
  a.append(h("div", { class: "a-head" }, [h("h3", { class: "a-title", text: c.title }), statusPill(c)]));
  var ruleName = E.ruleOfCard(c), ruleInfo = rulesByName.get(ruleName);
  if (ruleName) a.append(h("p", { class: "soft", text: "근거 규정: " + ruleName + (ruleInfo && ruleInfo.effective ? " (현행 시행 " + ruleInfo.effective + ")" : "") }));
  // 근거 조문이 답을 확인한 뒤 개정됐으면 가장 먼저 알린다
  if (c.stale) a.append(h("p", { class: "caution", text: "이 답의 근거 조문(" + c.stale.map(function (x) { return x.cite; }).join(", ") + ")이 답을 확인한 뒤 " +
    (c.stale.some(function (x) { return x.change === "removed"; }) ? "바뀌거나 없어졌습니다" : "바뀌었습니다") + (c.stale[0].effective ? "(현행 시행 " + c.stale[0].effective + ")" : "") +
    ". 아래 답은 개정 전 기준일 수 있으니 근거 버튼으로 현행 원문을 먼저 확인하세요." }));
  if (opts.missing && opts.missing.length) a.append(missingNote(opts.missing));
  else if (opts.soft) a.append(h("p", { class: "caution", text: "질문과 가장 가까운 답입니다. 찾던 내용이 아니면 아래 다른 답이나 관련 조문을 보세요." }));
  c.answer.forEach(function (p) { a.append(rich(p)); });
  a.append(h("div", { class: "facts-box" }, [h("table", { class: "facts" }, [h("caption", { class: "label", style: "text-align:left;padding:8px 10px 0", text: "핵심 정리와 근거" }), h("tbody", null, c.facts.map(function (f) {
    return h("tr", null, [h("th", { scope: "row", text: f.label }), h("td", null, [h("div", { text: f.value }), citeBtn(f.cite, f.quote)])]);
  }))])]));
  // 양식: 근거 조문이 부르는 양식, 그리고 물은 말에 이름이 든 양식("사직서 받고 싶어요"처럼 다른 규정 답이 나와도)
  var fbox = formBox(addForms(formsForCites(c.facts.map(function (f) { return f.cite; })), formsByWords(opts.question)));
  if (fbox) a.append(fbox);
  if (c.calc) { var cb = renderCalc(c.calc, opts.question); if (cb) a.append(cb); }
  // 계산기가 없는 답이라도 관련 계산기가 있으면(카드에 적어 둔 calc_link, 또는 금액·기간을 묻는 질문) 여는 버튼을 단다
  var link = c.calc ? null : c.calc_link || E.calcFor(opts.question);
  if (link && CALCS[link]) a.append(calcButton(link, opts.question));
  (c.notes || []).forEach(function (n) { a.append(h("p", { class: "note", text: n })); });
  if (c.law_refs && c.law_refs.length) {
    var laws = c.law_refs.map(function (l) { return l.law + " " + l.article; }).filter(function (x, i, arr) { return arr.indexOf(x) === i; });
    a.append(h("p", { class: "note", text: "외부 법령 대조: " + laws.join(", ") + " (국가법령정보 " + DATA.meta.lawChecked + " 확인)" }));
  }
  var rel = (c.related || []).concat(opts.alts || []).filter(function (x, i, arr) { return x !== c.id && arr.indexOf(x) === i && byId.has(x); });
  if (rel.length) a.append(h("div", { class: "more" }, [h("div", { class: "label", text: "함께 보면 좋은 내용" }), h("div", { class: "chips" }, rel.map(function (id) {
    // 다른 규정의 카드면 규정 이름을 앞에 붙인다(예: 업무규정 · 퇴직금과 중간정산)
    var r = byId.get(id), rr = E.ruleOfCard(r), own = E.ruleOfCard(c);
    return h("button", { class: "chip", type: "button", text: (rr && rr !== own ? rr + " · " : "") + r.title, onclick: function () { pick(r); } });
  }))]));
  if (REVIEW && c.check && c.check.length) a.append(h("details", { class: "box" }, [h("summary", { text: "검수 메모 " + c.check.length + "건 (담당부서 확인용)" }), h("div", null, c.check.map(function (t) { return h("p", { class: "soft", text: "· " + t }); }))]));
  if (opts.question) { var rh = relatedHits(opts.question, opts.score !== undefined && opts.score < 0.6); if (rh) a.append(rh); }
  feedbackRow(opts.question, c).forEach(function (x) { a.append(x); });
  return a;
}

// 결과는 한 번에 하나만 보인다(새로 찾으면 이전 결과를 지운다). 나침반 결과는 챗봇 대화와 다른 칸에 둔다.
function addTurn(qText, tag, node) {
  var t = h("div", { class: "turn" }, [h("div", { class: "q" }, [tag ? h("span", { class: "tag", text: tag }) : null, qText]), node]);
  $(tag === "나침반" ? "#compass-thread" : "#thread").replaceChildren(t);
  return t;
}
// 나침반에서 '챗봇 답 보기'를 누르면 질문하기로 넘어가 그 답을 보여 준다
function pick(c) {
  if (MODE === "compass") setMode("ask");
  addTurn(c.title, "선택", renderAnswer(c, {}));
  window.scrollTo({ top: $("#thread").offsetTop - 12, behavior: "smooth" });
}
// 최근 질문·최근 찾은 낱말(6개까지, 최근 것이 앞). 누르면 다시 찾는다. 화면을 닫으면 사라지고 어디에도 저장하지 않는다.
var RECENT = { ask: [], compass: [] };
function remember(kind, text) {
  RECENT[kind] = [text].concat(RECENT[kind].filter(function (x) { return x !== text; })).slice(0, 6);
  var box = $("#recent-" + kind);
  box.querySelector(".chips").replaceChildren.apply(box.querySelector(".chips"), RECENT[kind].map(function (s) {
    return h("button", { class: "chip", type: "button", text: s, onclick: function () { $("#q").value = s; if (kind === "compass") findWord(s); else ask(s); } });
  }));
  box.hidden = false;
}

var lastTopic = "";  // 바로 앞 질문(이어 묻기용). 화면을 닫으면 사라지고 어디에도 저장하지 않는다.
function ask(question) {
  question = question.trim(); if (!question) return;
  remember("ask", question);
  var ranked = cardIndex.score(question), dec = E.decide(ranked, question, cardIndex.lastQuery), node, joined = null;
  // "그럼 자가용으로 가면?"처럼 앞 질문에 이어 묻는 말이면 앞 질문의 주제를 붙여 다시 찾고, 더 잘 맞으면 그 결과를 쓴다
  if (lastTopic && E.isFollowUp(question)) {
    var q2 = lastTopic + " " + question, r2 = cardIndex.score(q2), d2 = E.decide(r2, q2, cardIndex.lastQuery);
    if (r2[0] && (!ranked[0] || r2[0].score > ranked[0].score)) { ranked = r2; dec = d2; joined = lastTopic; }
  }
  if (!joined) lastTopic = question;
  var plan = cardIndex.plan(joined ? joined + " " + question : question, ranked);
  if (dec.mode === "answer") node = renderAnswer(byId.get(dec.id), { question: question, alts: dec.alts, soft: dec.soft, score: dec.score, missing: dec.missing });
  else if (dec.mode === "ask") {
    // 넓은 질문이 아니면 후보 목록 아래에 가장 가까운 답을 바로 펼쳐 보여 준다(1순위가 맞는 경우가 많아 한 번 더 누르지 않게).
    var lead = dec.vague || !dec.lead ? null : h("div", { class: "lead" }, [
      h("div", { class: "label", text: "가장 가까운 답 (위 후보 중 1번)" }),
      renderAnswer(byId.get(dec.ids[0]), { question: question, alts: [] })
    ]);
    node = h("article", { class: "a" }, [
      h("div", { class: "a-head" }, [h("h3", { class: "a-title", text: dec.vague ? "조금 더 알려주세요" : "어떤 내용을 찾으세요?" })]),
      h("p", { text: dec.vague ? "질문이 넓어서 여러 답이 해당됩니다. 상황에 맞는 것을 고르세요." : lead ? "질문과 비슷한 답이 여러 개 있습니다. 1번 답을 아래에 펼쳤습니다. 상황이 다르면 다른 후보를 고르세요." : "딱 맞는 답을 찾지 못했습니다. 비슷한 후보 중에 고르시거나, 아래 관련 조문을 보세요." }),
      dec.missing && dec.missing.length ? missingNote(dec.missing) : (!dec.vague && !lead ? h("p", { class: "caution", text: "내규에 직접 정한 내용이 없을 수도 있습니다. 후보와 조문에서 찾지 못하면 관련 부서에 문의하세요." }) : null),
      // "가족수당 얼마"처럼 넓지만 계산을 원하는 질문이면 후보를 고르기 전에 계산기부터 열 수 있게
      !lead && E.calcFor(question) ? calcButton(E.calcFor(question), question) : null,
      // "사직서"처럼 양식 이름만 물었으면 후보를 고르기 전에 양식부터 받을 수 있게(펼친 답이 있으면 그 답 안에 있다)
      lead ? null : formBox(formsByWords(question)),
      h("div", { class: "cands" }, dec.ids.map(function (id) { return cardButton(id, pick); })),
      lead || relatedHits(question)
    ].filter(Boolean));
  } else {
    var hits = articles().search(question, 5);
