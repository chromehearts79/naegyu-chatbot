<div class="wrap">
  <header class="top">
    <h1 class="brand">내규챗봇<small id="domains-label">시범본</small></h1>
    <span class="basis" id="basis"></span>
    <p class="notice" id="notice"></p>
  </header>

  <div class="layout">
    <main>
      <section class="composer" aria-label="질문하기">
        <form class="ask-row" id="ask-form" autocomplete="off">
          <label for="q" class="label" hidden>질문</label>
          <input id="q" name="q" type="text" placeholder="예: 와이프가 다음 달 출산인데 저는 며칠 쉴 수 있나요?" aria-label="질문">
          <button class="btn" type="submit">묻기</button>
        </form>
        <div class="label">상황별로 보기</div>
        <div class="topic-groups" id="topics"></div>
        <div class="label">이렇게 물어보세요</div>
        <div class="chips examples" id="examples"></div>
      </section>
      <div class="thread" id="thread" aria-live="polite"></div>
      <section class="about" id="about" aria-label="검증 정보"></section>
    </main>

    <aside class="source" id="source" data-open="false" aria-label="근거 조문 원문">
      <div class="source-inner" id="source-inner">
        <button class="btn ghost close" type="button" id="source-close">닫기</button>
        <p class="empty-source">답변의 근거 조문(<span class="cite" style="pointer-events:none">복무세칙 제19조…</span>)을 누르면 여기에 원문이 열립니다.</p>
      </div>
    </aside>
  </div>
</div>

