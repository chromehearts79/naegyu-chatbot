<title>내규챗봇 시범본</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
/*__FONTS__*/
/* 규정집을 펼쳐 놓은 책상: 왼쪽은 묻고 답하는 칸, 오른쪽은 근거 조문 원문. 근거는 언제나 한 번 눌러 확인할 수 있게. */
:root {
  --paper: #f3f6f5;
  --surface: #ffffff;
  --sunk: #eaefed;
  --ink: #16201c;
  --ink-2: #4b5954;
  --ink-3: #5f6d68;
  --line: #d6dfdb;
  --line-strong: #7d8b86;  /* 입력칸·버튼처럼 눌러야 하는 것의 테두리(대비 3:1 이상) */
  --accent: #0b6b5d;
  --accent-ink: #ffffff;
  --accent-soft: #e1f0ec;
  --mark: #ffe38f;
  --mark-ink: #16201c;
  --sim: #cfe4ff;     /* 내규나침반: 같은 뜻의 다른 말·답 카드 근거 문구(넣은 낱말 그대로는 --mark) */
  --sim-ink: #16201c;
  --hl: #eef7f4;
  --warn: #8a5300;
  --warn-soft: #fff1d1;
  --ok: #1b6f40;
  --ok-soft: #def2e5;
  --danger: #b42318;
  /* 에이투지체는 파일 안에 들어 있어 폐쇄망에서도 같은 모양이다. 그 글꼴에 없는 글자(한자·일부 기호)만 PC 글꼴로 */
  --font-display: "A2Z", "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  --font-body: "A2Z", "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  --font-mono: ui-monospace, "SFMono-Regular", Consolas, Menlo, monospace;
  --radius: 10px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #0e1412; --surface: #151d1a; --sunk: #1b2421; --ink: #e3ebe7; --ink-2: #a4b2ad; --ink-3: #8c9b96;
    --line: #27322e; --line-strong: #5f6e69; --accent: #5cc2ae; --accent-ink: #06211c; --accent-soft: #15332e; --mark: #6b5513; --mark-ink: #fff6dc; --sim: #1f3d5e; --sim-ink: #e6f1ff;
    --hl: #17302b; --warn: #f2b54b; --warn-soft: #3a2c0e; --ok: #5bd08a; --ok-soft: #12301f; --danger: #f97066;
    color-scheme: dark;
  }
}
/* '밝게'를 고르면 PC가 어두운 모드여도 입력칸·선택 상자까지 밝게 */
:root[data-theme="light"] { color-scheme: light; }
:root[data-theme="dark"] {
  --paper: #0e1412; --surface: #151d1a; --sunk: #1b2421; --ink: #e3ebe7; --ink-2: #a4b2ad; --ink-3: #8c9b96;
  --line: #27322e; --line-strong: #5f6e69; --accent: #5cc2ae; --accent-ink: #06211c; --accent-soft: #15332e; --mark: #6b5513; --mark-ink: #fff6dc; --sim: #1f3d5e; --sim-ink: #e6f1ff;
  --hl: #17302b; --warn: #f2b54b; --warn-soft: #3a2c0e; --ok: #5bd08a; --ok-soft: #12301f; --danger: #f97066;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--paper); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.6;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0 48px; word-break: keep-all; overflow-wrap: anywhere;
}
button, input, textarea, select { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
.wrap { max-width: 1200px; margin: 0 auto; }
.featured .chip { color: var(--ink); font-weight: 600; }
.all-topics summary { cursor: pointer; font-size: 13.5px; color: var(--accent); font-weight: 600; }
.all-topics[open] summary { margin-bottom: 8px; }
.howto { margin: 0; padding: 10px 12px; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 13px; color: var(--ink-2); background: var(--sunk); border-radius: 8px; }
.howto b { color: var(--ink); }
.topic-block { display: grid; gap: 6px; }
.about-line { margin: 0; font-size: 14px; color: var(--ink-2); }

/* 머리 */
.top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; padding-block: 22px 14px; border-bottom: 1px solid var(--line); }
/* 화면 색 고르기(자동·밝게·어둡게) */
.theme { margin-left: auto; align-self: center; display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--line-strong); border-radius: 999px; }
.theme button { border: 0; background: transparent; color: var(--ink-2); border-radius: 999px; padding: 3px 12px; min-height: 28px; font-size: 13px; }
.theme button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); font-weight: 600; }
.old .theme { display: none; }
.brand { font-family: var(--font-display); font-weight: 700; font-size: 26px; letter-spacing: -0.01em; margin: 0; }
.brand small { font-family: var(--font-body); font-weight: 500; font-size: 13px; color: var(--accent); margin-left: 8px; letter-spacing: 0.02em; }
.basis { color: var(--ink-3); font-size: 13px; font-variant-numeric: tabular-nums; }
.notice { flex-basis: 100%; font-size: 13px; color: var(--ink-2); }
.notice b { color: var(--warn); font-weight: 600; }
.notice details { display: inline; }
.notice summary { display: inline; cursor: pointer; color: var(--accent); font-weight: 600; }
.notice details[open] summary { display: block; margin-bottom: 4px; }
.notice ul { margin: 0; padding-left: 18px; display: grid; gap: 3px; }
.notice li b { color: var(--ink); }

/* 처음에는 한 칸(원문 칸 접음). 근거를 눌러 원문을 열면(.reading) 넓은 화면에서 오른쪽에 원문 칸이 붙는다 */
.layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 20px; }
@media (min-width: 1000px) {
  .wrap:not(.reading) { max-width: 880px; }
  .wrap:not(.reading) .source { display: none; }
  .wrap.reading .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); }
}

/* 묻는 칸 */
.composer { display: grid; gap: 12px; }
.ask-row { display: flex; gap: 8px; }
.ask-row input {
  flex: 1; min-width: 0; padding: 13px 14px; border: 1.5px solid var(--line-strong); border-radius: var(--radius);
  background: var(--surface); font-size: 16px;
}
.ask-row input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
.btn { border: 0; border-radius: var(--radius); padding: 0 18px; background: var(--accent); color: var(--accent-ink); font-weight: 600; white-space: nowrap; }
.btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--line-strong); padding: 6px 12px; font-weight: 500; font-size: 13px; min-height: 36px; }
.label { font-size: 12px; letter-spacing: 0.06em; color: var(--ink-3); font-weight: 600; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 12px; font-size: 13.5px; color: var(--ink-2);
}
.chip:hover { border-color: var(--accent); color: var(--accent); }
.chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.topic-groups { display: grid; gap: 8px; }
.topic-group { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.topic-group > span { font-size: 12.5px; font-weight: 600; color: var(--ink-2); min-width: 72px; }

/* 대화 */
.thread { display: grid; gap: 22px; margin-top: 22px; }
.turn { display: grid; gap: 10px; }
.q { justify-self: end; max-width: 85%; background: var(--sunk); border-radius: 14px 14px 4px 14px; padding: 9px 14px; font-size: 16px; }
.q .tag { font-size: 12px; color: var(--ink-3); margin-right: 6px; letter-spacing: 0.04em; }
.a { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px 18px 14px; display: grid; gap: 12px; min-width: 0; }
.a-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
.a-title { font-family: var(--font-display); font-weight: 700; font-size: 20px; margin: 0; text-wrap: balance; }
.pill { font-size: 12px; border-radius: 999px; padding: 2px 9px; font-weight: 600; letter-spacing: 0.01em; white-space: nowrap; }
.pill.ok { background: var(--ok-soft); color: var(--ok); }
.pill.warn { background: var(--warn-soft); color: var(--warn); }
/* 문단은 칸 끝까지 쓴다(글자 수로 폭을 묶으면 넓은 칸에서도 그 앞에서 줄이 바뀌어 끊겨 보인다). 마지막 줄에 한두 낱말만 남지 않게 */
.a p { margin: 0; text-wrap: pretty; }
.a strong { font-weight: 600; background: linear-gradient(transparent 62%, var(--accent-soft) 62%); }
.facts { width: 100%; border-collapse: collapse; font-size: 14px; }
.facts-box { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
.facts th, .facts td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
.facts tr:last-child th, .facts tr:last-child td { border-bottom: 0; }
.facts th { font-weight: 500; color: var(--ink-2); width: 30%; background: var(--sunk); }
.cite {
  display: inline-flex; align-items: center; min-height: 24px; margin-top: 3px; border: 0; background: var(--accent-soft); color: var(--accent); border-radius: 5px;
  padding: 2px 8px; font-size: 12.5px; font-family: var(--font-mono), var(--font-body); font-weight: 500; text-align: left;
}
.cite:hover { background: var(--accent); color: var(--accent-ink); }
/* 서식 받기: 조문 아래(질문하기는 핵심 정리 표 아래) 따로 두는 '양식' 칸 — 한글 파일 받기 단추, 어느 별지인지, 받은 뒤 안내 */
.form-box { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 8px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--sunk); }
.form-label { font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
.form-item { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
.form-item[hidden] { display: none; }
.form-meta { font-size: 12.5px; color: var(--ink-3); }
.form-dl {
  display: inline-flex; align-items: center; gap: 4px; min-height: 28px; padding: 2px 10px 2px 4px;
  border: 1px solid var(--accent); border-radius: 6px; background: var(--surface); color: var(--accent); font: inherit; font-size: 13px; font-weight: 600; line-height: 1.4;
}
.form-dl .hwp { background: var(--accent); color: var(--accent-ink); border-radius: 4px; padding: 0 4px; font-size: 12px; }
.form-dl:hover { background: var(--accent); color: var(--accent-ink); }
.form-dl:hover .hwp { background: var(--accent-ink); color: var(--accent); }
.form-note { flex-basis: 100%; font-size: 13px; color: var(--ink-2); background: var(--accent-soft); border-radius: 6px; padding: 6px 10px; margin: 0; }
.caution { font-size: 14px; color: var(--ink); background: var(--warn-soft); border-left: 3px solid var(--warn); padding: 8px 10px; border-radius: 6px; margin: 0; }
.note { font-size: 13px; color: var(--ink-2); border-left: 3px solid var(--line); padding-left: 10px; }
.soft { font-size: 13px; color: var(--ink-3); }
.more { display: grid; gap: 6px; }
details.box { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
.box.multi { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; display: grid; gap: 8px; background: var(--sunk); margin-top: 6px; }
.box.multi p { margin: 0; font-size: 14px; }
details.box summary { cursor: pointer; font-size: 13.5px; color: var(--ink-2); }
details.box[open] summary { margin-bottom: 8px; }
.feedback { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; border-top: 1px dashed var(--line); padding-top: 10px; }
.report { display: grid; gap: 8px; }
.report textarea { width: 100%; min-height: 96px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 8px; background: var(--paper); font-size: 13px; }

/* 계산기 */
.calc { background: var(--hl); border-radius: 10px; padding: 12px 14px; display: grid; gap: 10px; }
.calc h4 { margin: 0; font-size: 14px; font-weight: 600; }
.calc form { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: end; }
.calc label { display: grid; gap: 3px; font-size: 12.5px; color: var(--ink-2); }
.calc label.inline { display: flex; align-items: center; gap: 8px; min-height: 32px; cursor: pointer; }
.calc-hint { flex-basis: 100%; margin: -4px 0 0; font-size: 12.5px; color: var(--ink-3); }
.calc input[type=checkbox] { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
.calc input[type=date], .calc input[type=number], .calc select { padding: 6px 8px; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--surface); color: var(--ink); min-width: 0; font: inherit; }
.calc label.need > span::after { content: "확인 필요"; margin-left: 6px; font-size: 12px; font-weight: 600; color: var(--warn); background: var(--warn-soft); border-radius: 999px; padding: 1px 7px; }
.calc label.need input, .calc label.need select { border-color: var(--warn); }
.calc .need-msg { margin: 0; font-size: 13px; color: var(--warn); }
.calc-link { margin: 2px 0; }
.calc input[type=number] { width: 80px; }
.calc table { width: 100%; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
.calc td { padding: 5px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
.calc td:first-child { color: var(--ink-2); width: 42%; padding-right: 10px; }
.calc .err { color: var(--danger); font-size: 13px; }
/* 고치는 도중에는 마지막 결과를 흐리게 남긴다(지웠다 다시 쓰는 사이 결과표가 사라졌다 나타나며 화면이 들썩이지 않게) */
.calc .stale { opacity: 0.4; pointer-events: none; }

/* 되묻기·주제 목록 */
.cands { display: grid; gap: 8px; }
.lead { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line); display: grid; gap: 8px; }
.lead > .a { padding: 0; border: 0; box-shadow: none; background: transparent; }
.cand { text-align: left; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; padding: 10px 12px; display: grid; gap: 2px; }
.cand:hover { border-color: var(--accent); }
.cand b { font-weight: 600; }
.cand span { font-size: 13px; color: var(--ink-2); }
.cand-rule { font-style: normal; font-size: 12px; color: var(--accent); font-weight: 600; }
.hits { display: grid; gap: 8px; }
.hit { text-align: left; border: 0; border-left: 3px solid var(--line); background: transparent; padding: 4px 0 4px 10px; display: grid; gap: 2px; }
.hit:hover { border-left-color: var(--accent); }
.hit b { font-size: 13.5px; font-weight: 600; }
.hit span { font-size: 13px; color: var(--ink-2); }

/* 원문 칸 */
.source { min-width: 0; }
.source-inner {
  background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; display: grid; gap: 10px;
  position: sticky; top: calc(env(safe-area-inset-top, 0px) + 16px); max-height: calc(100vh - 32px); overflow: auto;
}
.source h2 { font-family: var(--font-display); font-size: 18px; margin: 0; }
.source .meta { font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.law { font-size: 14px; display: grid; gap: 6px; }
.law p { margin: 0; white-space: pre-wrap; }
.law p.para { padding: 4px 6px; border-radius: 6px; }
.law p.para.on { background: var(--hl); box-shadow: inset 3px 0 0 var(--accent); }
.law mark { background: var(--mark); color: var(--mark-ink); border-radius: 2px; padding: 0 1px; }
.law .tbl { overflow-x: auto; }
.law table { border-collapse: collapse; font-size: 12.5px; }
.law td, .law th { border: 1px solid var(--line); padding: 4px 6px; vertical-align: top; }
.close { justify-self: end; }
.empty-source { color: var(--ink-3); font-size: 14px; }
@media (max-width: 999px) {
  .source { position: fixed; inset: auto 0 0 0; z-index: 20; padding: 0 max(8px, env(safe-area-inset-left, 0px)) env(safe-area-inset-bottom, 0px) max(8px, env(safe-area-inset-right, 0px)); }
  .source[data-open="false"] { display: none; }
  .source-inner { position: static; max-height: 78vh; border-radius: 14px 14px 0 0; box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.18); }
}

/* 내규나침반: 낱말이 나오는 곳을 내규별로 묶어(왼쪽) 보여 주고, 누르면 그 내규 원문 전체를 오른쪽 원문 칸에 연다 */
.modes { justify-self: start; display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line-strong); border-radius: 999px; }
.modes button { border: 0; background: transparent; color: var(--ink-2); border-radius: 999px; padding: 4px 16px; min-height: 36px; font-size: 14px; font-weight: 600; }
.modes button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
.compass-note { margin: 0; font-size: 14px; color: var(--ink-2); }
/* 최근 단추 줄. 아래 .compass-only 보다 먼저 써야 질문하기 화면에서 '최근 찾은 낱말' 줄이 숨는다 */
.recent { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
.compass-only { display: none; }
.compassing .compass-only { display: block; }
.compassing .ask-only { display: none; }
.compassing .recent.compass-only { display: flex; }
.recent[hidden] { display: none !important; }
.recent .chips { gap: 6px; }
.named { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; background: var(--hl); border-radius: 8px; padding: 8px 12px; font-size: 14px; }
.linkish { border: 0; background: transparent; padding: 0; color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-align: left; }
.wrap.compassing { max-width: 1200px; }
.wrap.compassing .layout { grid-template-columns: minmax(0, 1fr); }
.compassing .source { display: none; }
/* 왼쪽 내규 목록. 내규 이름은 강조색으로 원문 글씨(검은색)와 구분한다. 후보 카드의 규정 이름(.cand-rule)과 같은 색 */
.cbody { display: grid; gap: 16px; margin-top: 14px; }
.clist { display: grid; gap: 2px; align-content: start; min-width: 0; }
.chead { margin: 0 0 6px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
.rl { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; text-align: left; border: 0; border-radius: 8px; background: transparent; padding: 7px 10px; color: var(--accent); font-size: 14.5px; }
.rl b { font-weight: 600; }
.rl span { color: var(--ink-3); font-size: 13px; font-variant-numeric: tabular-nums; }
.rl:hover { background: var(--hl); }
.rl[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
.rl[aria-pressed="true"] span { color: var(--accent-ink); }
.rl[hidden] { display: none; }
.clist .more { justify-self: start; border: 0; background: transparent; padding: 6px 10px; color: var(--ink-2); font-size: 13px; text-decoration: underline; text-underline-offset: 3px; }
/* 오른쪽 원문 칸 */
.cpane { min-width: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; display: grid; gap: 8px; align-content: start; }
.cpane h3 { margin: 0; font-family: var(--font-display); font-size: 19px; color: var(--accent); }
.cpane .meta { font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.back { justify-self: start; }
.why { margin: 0; font-size: 13px; color: var(--ink-2); }
.jump { display: flex; flex-wrap: wrap; gap: 4px; }
.jump button { border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--ink-2); padding: 1px 9px; min-height: 28px; font-size: 12.5px; }
.jump button:hover { border-color: var(--accent); color: var(--accent); }
.jump button[aria-current="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.law mark.sim, .legend mark.sim { background: var(--sim); color: var(--sim-ink); }
.legend mark { background: var(--mark); color: var(--mark-ink); border-radius: 2px; padding: 0 1px; }
.law mark.now { outline: 2px solid var(--accent); outline-offset: 1px; }
/* ▲▼ 줄: 원문 칸 안쪽 여백(14px)만큼 올려 칸 맨 위에 붙인다. 위로 뻗는 배경 그림자는 바로 위 '현행 시행 · 찾은 곳' 줄을 덮어 쓰지 않는다 */
.cnav { position: sticky; top: -14px; z-index: 1; display: flex; align-items: center; gap: 6px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 4px 6px 4px 10px; }
.cnav span { flex: 1; font-size: 13px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.cnav .btn.ghost { min-height: 32px; min-width: 40px; padding: 2px 8px; }
.legend { margin: 0; font-size: 12.5px; color: var(--ink-3); }
/* 다른 낱말 속에서 걸린 곳(‘개인정보’ 속 ‘인정’): 노란색 대신 점선, 세지 않음 */
.law mark.off { background: transparent; color: inherit; border-bottom: 2px dotted var(--ink-3); border-radius: 0; padding: 0; }
.legend .off { border-bottom: 2px dotted var(--ink-3); }
/* 걸린 말별 묶음 단추: 누르면 그 말로 걸린 곳을 목록·원문에서 켜고 끈다. ‘다른 낱말 속’ 묶음은 처음에 꺼 두고 점선 테두리 */
.groups { display: grid; gap: 6px; }
.groups .row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.groups .label { margin-right: 2px; }
.gchip { border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--ink-2); padding: 2px 10px; min-height: 30px; font-size: 13px; }
.gchip span { margin-left: 5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.gchip:hover { border-color: var(--accent); color: var(--accent); }
.gchip.fold { border-style: dashed; }
.gchip[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); border-style: solid; color: var(--ink); }
.gchip[aria-pressed="true"] span { color: var(--ink-2); }
.gchip[hidden] { display: none; }
.groups .more { border: 0; background: transparent; padding: 4px 6px; color: var(--ink-2); font-size: 13px; text-decoration: underline; text-underline-offset: 3px; }
.chapter { margin: 12px 0 0; font-size: 13px; font-weight: 600; color: var(--ink-3); letter-spacing: 0.02em; }
.art { scroll-margin-top: 56px; }
/* 넓은 화면: 목록과 원문을 나란히, 원문 칸은 화면에 붙어 그 안에서만 굴린다 */
@media (min-width: 1000px) {
  .cbody { grid-template-columns: minmax(220px, 290px) minmax(0, 1fr); align-items: start; }
  .cpane { position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow: auto; }
  .back { display: none; }
}
/* 휴대폰 폭: 목록을 먼저 보이고, 내규를 누르면 원문을 화면 전체로. '← 내규 목록'으로 돌아간다 */
@media (max-width: 999px) {
  .cbody.picked .clist { display: none; }
  .cbody:not(.picked) .cpane { display: none; }
  .cnav { top: 0; }
  .rl { min-height: 44px; align-items: center; }
  .jump button { min-height: 36px; }
}
details.annex > summary { cursor: pointer; font-size: 14px; font-weight: 600; }

/* 검증 정보 */
.about { margin-top: 36px; border-top: 1px solid var(--line); padding-top: 18px; display: grid; gap: 12px; }
.about h3 { font-family: var(--font-display); font-size: 17px; margin: 0; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
.stat { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
.stat b { display: block; font-size: 20px; font-variant-numeric: tabular-nums; font-family: var(--font-mono), var(--font-body); }
.stat span { font-size: 12.5px; color: var(--ink-2); }
.about ul { margin: 0; padding-left: 18px; font-size: 13.5px; color: var(--ink-2); display: grid; gap: 4px; }
/* 휴대폰 폭: 손가락으로 누르는 것은 44px 이상 */
@media (max-width: 999px) {
  .chip, .btn.ghost, .calc input[type=date], .calc input[type=number], .calc select, .calc label.inline, .gchip, .form-dl { min-height: 44px; }
  .cite { min-height: 32px; }
  .theme button { min-height: 40px; }
}
/* 화면에는 안 보이고 화면 읽기 프로그램만 읽는 글 */
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
/* 여는 동안 안내(6MB 넘는 파일이라 사양 낮은 PC에서 몇 초 걸린다). 스크립트가 끝나면 지운다 */
.loading { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--hl); color: var(--ink-2); font-size: 14px; }
.old .loading { display: none; }
@media (prefers-reduced-motion: no-preference) { .turn { animation: rise 0.25s ease-out; } @keyframes rise { from { transform: translateY(6px); opacity: 0.6; } to { transform: none; opacity: 1; } } }
