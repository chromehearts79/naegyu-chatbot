// 분야 버튼: 누르면 그 분야의 답 목록을 보여 준다. refs 는 "분야id:주제id", extra 는 함께 보여 줄 카드 id
function topicCards(dmId, tId) {
  var inTopic = DATA.cards.filter(function (c) { return c.domain === dmId && c.topics.indexOf(tId) >= 0; });
  // 규정 전체 분야는 규정별 개요 카드만 보여 준다(개요에서 그 규정의 다른 카드로 이어진다). 개요 카드가 없는 묶음(상황별 종합)은 카드를 모두 보여 준다.
  var ov = inTopic.filter(function (c) { return dmId !== "all_rules" || c.overview; });
  return (ov.length ? ov : inTopic).map(function (c) { return c.id; });
}
function topicName(ref) {
  var p = ref.split(":"), dm = DATA.domains.filter(function (d) { return d.id === p[0]; })[0];
  return ((dm && dm.topics.filter(function (t) { return t.id === p[1]; })[0]) || {}).name || ref;
}
function showTopics(title, refs, extra) {
  var groups = refs.map(function (r) { var p = r.split(":"); return { name: topicName(r), ids: topicCards(p[0], p[1]) }; });
  extra = (extra || []).filter(function (id) { return byId.get(id); });
  if (extra.length) groups.push({ name: "관련 규정 안내", ids: extra });
