    return h("button", { class: "chip", type: "button", text: (rr && rr !== own ? rr + " · " : "") + r.title, onclick: function () { pick(r); } });
  }))]));
  if (REVIEW && c.check && c.check.length) a.append(h("details", { class: "box" }, [h("summary", { text: "검수 메모 " + c.check.length + "건 (담당부서 확인용)" }), h("div", null, c.check.map(function (t) { return h("p", { class: "soft", text: "· " + t }); }))]));
  if (opts.question) { var rh = relatedHits(opts.question, opts.score !== undefined && opts.score < 0.6); if (rh) a.append(rh); }
  feedbackRow(opts.question, c).forEach(function (x) { a.append(x); });
  return a;
}

function addTurn(qText, tag, node) {
  var t = h("div", { class: "turn" }, [h("div", { class: "q" }, [tag ? h("span", { class: "tag", text: tag }) : null, qText]), node]);
  var thread = $("#thread");
  thread.insertBefore(t, thread.firstChild);
  return t;
}
function pick(c) { addTurn(c.title, "선택", renderAnswer(c, {})); window.scrollTo({ top: $("#thread").offsetTop - 12, behavior: "smooth" }); }

var lastTopic = "";  // 바로 앞 질문(이어 묻기용). 화면을 닫으면 사라지고 어디에도 저장하지 않는다.
function ask(question) {
  question = question.trim(); if (!question) return;
  var ranked = cardIndex.score(question), dec = E.decide(ranked, question, cardIndex.lastQuery), node, joined = null;
  // "그럼 자가용으로 가면?"처럼 앞 질문에 이어 묻는 말이면 앞 질문의 주제를 붙여 다시 찾고, 더 잘 맞으면 그 결과를 쓴다
  if (lastTopic && E.isFollowUp(question)) {
    var q2 = lastTopic + " " + question, r2 = cardIndex.score(q2), d2 = E.decide(r2, q2, cardIndex.lastQuery);
    if (r2[0] && (!ranked[0] || r2[0].score > ranked[0].score)) { ranked = r2; dec = d2; joined = lastTopic; }
  }
  if (!joined) lastTopic = question;
  var plan = cardIndex.plan(joined ? joined + " " + question : question, ranked);
  if (dec.mode === "answer") node = renderAnswer(byId.get(dec.id), { question: question, alts: dec.alts, soft: dec.soft, score: dec.score, missing: dec.missing });
  else if (dec.mode === "ask") {
    // 넓은 질문이 아니면 후보 목록 아래에 가장 가까운 답을 바로 펼쳐 보여 준다(1순위가 맞는 경우가 많아 한 번 더 누르지 않게).
    var lead = dec.vague || !dec.lead ? null : h("div", { class: "lead" }, [
      h("div", { class: "label", text: "가장 가까운 답 (위 후보 중 1번)" }),
      renderAnswer(byId.get(dec.ids[0]), { question: question, alts: [] })
    ]);
    node = h("article", { class: "a" }, [
      h("div", { class: "a-head" }, [h("h3", { class: "a-title", text: dec.vague ? "조금 더 알려주세요" : "어떤 내용을 찾으세요?" })]),
      h("p", { text: dec.vague ? "질문이 넓어서 여러 답이 해당됩니다. 상황에 맞는 것을 고르세요." : lead ? "질문과 비슷한 답이 여러 개 있습니다. 1번 답을 아래에 펼쳤습니다. 상황이 다르면 다른 후보를 고르세요." : "딱 맞는 답을 찾지 못했습니다. 비슷한 후보 중에 고르시거나, 아래 관련 조문을 보세요." }),
      dec.missing && dec.missing.length ? missingNote(dec.missing) : (!dec.vague && !lead ? h("p", { class: "caution", text: "내규에 직접 정한 내용이 없을 수도 있습니다. 후보와 조문에서 찾지 못하면 담당부서에 확인하세요." }) : null),
      h("div", { class: "cands" }, dec.ids.map(function (id) { return cardButton(id, pick); })),
      lead || relatedHits(question)
    ].filter(Boolean));
  } else {
    var hits = articles().search(question, 5);
    node = h("article", { class: "a" }, [
      h("div", { class: "a-head" }, [h("h3", { class: "a-title", text: "준비된 답이 없습니다" }), h("span", { class: "pill warn", text: "맞는 답을 못 찾음" })]),
      h("p", { text: "준비된 답 중에서 질문에 맞는 것을 찾지 못했습니다. 대신 규정 " + DATA.rules.length + "개 전체에서 관련 조문을 찾았습니다. 조문을 누르면 원문이 열립니다. 다른 말로 다시 물어보셔도 됩니다." }),
      h("p", { class: "caution", text: "아래 조문에도 없다면 내규에 직접 정한 내용이 없는 것일 수 있습니다. 담당부서에 확인하세요." }),
      hits.length ? h("div", { class: "hits" }, hits.map(hitButton.bind(null, question))) : h("p", { class: "soft", text: "관련 조문도 찾지 못했습니다." })
    ]);
    feedbackRow(question, null).forEach(function (x) { node.append(x); });
  }
  if (joined) node.insertBefore(h("p", { class: "soft", text: "앞 질문 ‘" + joined + "’에 이어서 찾았습니다." }), node.firstChild.nextSibling);
  // 한 질문에 여러 가지를 물었으면, 첫 답이 다루지 못한 부분을 맡는 카드를 함께 보여 준다
  if (plan.length >= 2) {
    var shown = dec.mode === "answer" ? dec.id : (dec.ids || [])[0];
    var more = plan.filter(function (p) { return p.id !== shown; });
    if (more.length) node.append(h("div", { class: "box multi" }, [
      h("p", { text: "질문에 여러 가지가 들어 있어 나눠 찾았습니다. 아래 답도 함께 확인하세요." }),
      h("div", { class: "cands" }, more.map(function (p) {
        var b = cardButton(p.id, pick);
        b.prepend(h("em", { class: "cand-rule", text: "‘" + p.words.join("·") + "’ 관련" }));
        return b;
      }))
    ]));
  }
  addTurn(question, null, node);
}

/* ── 처음 화면 ─────────────────────────────── */
$("#basis").textContent = "답변 확인 기준 " + DATA.meta.basis + " · 규정 " + DATA.rules.length + "개 (최근 개정 시행 " + DATA.meta.latestEffective + ")";
(function () {
  // 오래된 사본이 돌아다닐 수 있어, 만든 지 90일이 넘으면 위에 알린다
  var days = Math.floor((Date.now() - new Date(DATA.meta.built + "T00:00:00").getTime()) / 864e5);
  var maxAge = (DATA.meta.site || {}).maxAgeDays || 90;
  var old = days > maxAge ? "<b>이 화면은 만든 지 " + days + "일이 지났습니다.</b> 그 사이 규정이 바뀌었을 수 있으니 최신판인지 확인하세요. " : "";
  var stale = DATA.meta.stale ? "규정 개정 뒤 다시 확인하지 못한 답이 " + DATA.meta.stale + "개 있습니다(답에 표시). " : "";
  $("#notice").innerHTML = old + stale + "<b>AI가 작성한 답변</b>입니다. 인용 문구는 프로그램으로 원문과 대조했고 다른 AI로 다시 검증했지만, <b>담당부서 검수 전</b>입니다. 중요한 결정 전에는 근거 조문 원문과 담당부서에 확인하세요.";
})();
$("#domains-label").textContent = "시범본 · " + DATA.domains.map(function (d) { return d.name; }).join(" · ");
DATA.domains.forEach(function (dm) {
  var row = h("div", { class: "topic-group" }, [h("span", { text: dm.name })]);
  dm.topics.forEach(function (t) {
    row.append(h("button", { class: "chip", type: "button", text: t.name, onclick: function (e) {
      document.querySelectorAll("#topics .chip").forEach(function (b) { b.classList.remove("on"); });
      e.currentTarget.classList.add("on");
      // 규정 전체 분야는 규정마다 개요 카드만 먼저 보여준다(개요에서 그 규정의 다른 카드로 이어진다).
      var inTopic = DATA.cards.filter(function (c) { return c.domain === dm.id && c.topics.indexOf(t.id) >= 0; });
      // 규정 전체 분야는 규정별 개요 카드만 보여 준다. 개요 카드가 없는 묶음(상황별 종합)은 카드를 모두 보여 준다.
      var ov = inTopic.filter(function (c) { return dm.id !== "all_rules" || c.overview; });
      var ids = (ov.length ? ov : inTopic).map(function (c) { return c.id; });
      addTurn(t.name, "상황", h("article", { class: "a" }, [h("div", { class: "a-head" }, [h("h3", { class: "a-title", text: t.name })]), h("div", { class: "cands" }, ids.map(function (id) { return cardButton(id, pick); }))]));
    } }));
  });
  $("#topics").append(row);
});
["배우자 출산휴가 며칠이에요?", "시험관 시술 때문에 병원 가야 해요", "육아휴직 2년 하면 근속 다 인정돼요?", "장모님 돌아가셨는데 며칠 쉬어요?", "반차 쓰면 몇 시간 일해요?", "출산"].forEach(function (s) {
  $("#examples").append(h("button", { class: "chip", type: "button", text: s, onclick: function () { $("#q").value = s; ask(s); } }));
});
$("#ask-form").addEventListener("submit", function (e) { e.preventDefault(); ask($("#q").value); $("#q").select(); });

(function about() {
  var m = DATA.meta, v = m.verify, s = m.search;
  var stat = function (b, span) { return h("div", { class: "stat" }, [h("b", { text: b }), h("span", { text: span })]); };
  $("#about").append(
    h("h3", { text: "이 시범본은 이렇게 검증했습니다" }),
    h("div", { class: "stats" }, [
      stat(m.cards + "장", "문답 카드 (예상 질문 " + m.questions + "개)"),
      stat(m.quotesOk + "/" + m.facts, "인용 문구가 원문과 글자 그대로 일치"),
      stat((v.match + v.judged) + "/" + v.total, "다른 AI로 다시 확인한 항목"),
      stat(m.reviewed + "/" + m.cards, "담당부서 검수를 마친 답"),
      stat(s.dev, "카드에 없는 시험 질문 처리 정확도"),
      stat(s.top3, "처음 보는 표현, 3순위 안 정답")
    ]),
    h("ul", null, [
      h("li", { text: "1단계 프로그램 검사: 인용한 조·항·호가 실제로 있는지, 인용 문구와 숫자가 원문과 같은지 확인했습니다." }),
      h("li", { text: "2단계 AI 재확인: 다른 AI 모델에 답을 숨긴 채 조문만 주고 같은 항목을 다시 찾게 해 비교했습니다. 결재권자 표는 프로그램으로 칸마다 대조했습니다." }),
      h("li", { text: "외부 법령 대조: 내규가 인용하거나 내규와 다른 법령 조문(남녀고용평등법, 근로기준법, 개인정보 보호법 등)을 국가법령정보로 확인했습니다(" + m.lawChecked + ")." }),
      h("li", { text: "3단계 담당부서 검수는 아직입니다. 검수를 마친 답에는 '담당부서 검수 완료'가 표시됩니다. 그 전까지는 중요한 결정 전에 원문과 담당부서에 확인하세요." }),
      h("li", { text: "시험 질문 정확도는 검색 기준값을 고를 때 같은 질문을 써서 실제보다 높게 나왔을 수 있습니다. 담당부서가 만든 질문으로 다시 재야 합니다." })
    ]),
    REVIEW && m.ruleFixes.length ? h("details", { class: "box" }, [h("summary", { text: "만들다 발견한 규정 정비 후보 " + m.ruleFixes.length + "건" }), h("ul", null, m.ruleFixes.map(function (t) { return h("li", { text: t }); }))]) : null
  );
})();

// 처음부터 작동하는 모습을 보여 주는 예시 한 건
addTurn("와이프가 다음 달 출산 예정인데 저는 며칠 쉴 수 있나요?", "예시", renderAnswer(byId.get("spouse-birth-leave"), { example: true }));
</script>
