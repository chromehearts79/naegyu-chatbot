<title>내규챗봇 시범본</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
/* 규정집을 펼쳐 놓은 책상: 왼쪽은 묻고 답하는 칸, 오른쪽은 근거 조문 원문. 근거는 언제나 한 번 눌러 확인할 수 있게. */
:root {
  --paper: #f3f6f5;
  --surface: #ffffff;
  --sunk: #eaefed;
  --ink: #16201c;
  --ink-2: #4b5954;
  --ink-3: #75837e;
  --line: #d6dfdb;
  --accent: #0b6b5d;
  --accent-ink: #ffffff;
  --accent-soft: #e1f0ec;
  --mark: #ffe38f;
  --mark-ink: #16201c;
  --hl: #eef7f4;
  --warn: #8a5300;
  --warn-soft: #fff1d1;
  --ok: #1b6f40;
  --ok-soft: #def2e5;
  --danger: #b42318;
  /* 폐쇄망에서도 열리도록 외부 글꼴을 부르지 않고 PC에 깔린 글꼴만 쓴다 */
  --font-display: "Noto Serif KR", "AppleMyungjo", "Batang", serif;
  --font-body: "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  --font-mono: ui-monospace, "SFMono-Regular", Consolas, Menlo, monospace;
  --radius: 10px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #0e1412; --surface: #151d1a; --sunk: #1b2421; --ink: #e3ebe7; --ink-2: #a4b2ad; --ink-3: #7b8a85;
    --line: #27322e; --accent: #5cc2ae; --accent-ink: #06211c; --accent-soft: #15332e; --mark: #6b5513; --mark-ink: #fff6dc;
    --hl: #17302b; --warn: #f2b54b; --warn-soft: #3a2c0e; --ok: #5bd08a; --ok-soft: #12301f; --danger: #f97066;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #0e1412; --surface: #151d1a; --sunk: #1b2421; --ink: #e3ebe7; --ink-2: #a4b2ad; --ink-3: #7b8a85;
  --line: #27322e; --accent: #5cc2ae; --accent-ink: #06211c; --accent-soft: #15332e; --mark: #6b5513; --mark-ink: #fff6dc;
  --hl: #17302b; --warn: #f2b54b; --warn-soft: #3a2c0e; --ok: #5bd08a; --ok-soft: #12301f; --danger: #f97066;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--paper); color: var(--ink); font-family: var(--font-body); font-size: 15px; line-height: 1.6;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0 48px; word-break: keep-all; overflow-wrap: anywhere;
}
button, input, textarea, select { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
.wrap { max-width: 1200px; margin: 0 auto; }

/* 머리 */
.top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; padding-block: 22px 14px; border-bottom: 1px solid var(--line); }
.brand { font-family: var(--font-display); font-weight: 700; font-size: 26px; letter-spacing: -0.01em; margin: 0; }
.brand small { font-family: var(--font-body); font-weight: 500; font-size: 13px; color: var(--accent); margin-left: 8px; letter-spacing: 0.02em; }
.basis { color: var(--ink-3); font-size: 13px; font-variant-numeric: tabular-nums; }
.notice { flex-basis: 100%; font-size: 13px; color: var(--ink-2); }
.notice b { color: var(--warn); font-weight: 600; }

.layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 20px; }
@media (min-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); } }

/* 묻는 칸 */
.composer { display: grid; gap: 12px; }
.ask-row { display: flex; gap: 8px; }
.ask-row input {
  flex: 1; min-width: 0; padding: 13px 14px; border: 1.5px solid var(--line); border-radius: var(--radius);
  background: var(--surface); font-size: 16px;
}
.ask-row input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
.btn { border: 0; border-radius: var(--radius); padding: 0 18px; background: var(--accent); color: var(--accent-ink); font-weight: 600; white-space: nowrap; }
.btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--line); padding: 6px 12px; font-weight: 500; font-size: 13px; }
.label { font-size: 12px; letter-spacing: 0.06em; color: var(--ink-3); font-weight: 600; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 12px; font-size: 13.5px; color: var(--ink-2);
}
.chip:hover { border-color: var(--accent); color: var(--accent); }
.chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.examples .chip { border-style: dashed; }
.topic-groups { display: grid; gap: 8px; }
.topic-group { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.topic-group > span { font-size: 12.5px; font-weight: 600; color: var(--ink-2); min-width: 72px; }

/* 대화 */
.thread { display: grid; gap: 22px; margin-top: 22px; }
.turn { display: grid; gap: 10px; }
.q { justify-self: end; max-width: 85%; background: var(--sunk); border-radius: 14px 14px 4px 14px; padding: 9px 14px; font-size: 15px; }
.q .tag { font-size: 11px; color: var(--ink-3); margin-right: 6px; letter-spacing: 0.04em; }
.a { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px 18px 14px; display: grid; gap: 12px; min-width: 0; }
.a-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
.a-title { font-family: var(--font-display); font-weight: 700; font-size: 20px; margin: 0; text-wrap: balance; }
.pill { font-size: 11.5px; border-radius: 999px; padding: 2px 9px; font-weight: 600; letter-spacing: 0.01em; white-space: nowrap; }
.pill.ok { background: var(--ok-soft); color: var(--ok); }
.pill.warn { background: var(--warn-soft); color: var(--warn); }
.pill.ex { background: var(--sunk); color: var(--ink-3); }
.a p { margin: 0; max-width: 68ch; }
.a strong { font-weight: 600; background: linear-gradient(transparent 62%, var(--accent-soft) 62%); }
.facts { width: 100%; border-collapse: collapse; font-size: 14px; }
.facts-box { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
.facts th, .facts td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
.facts tr:last-child th, .facts tr:last-child td { border-bottom: 0; }
.facts th { font-weight: 500; color: var(--ink-2); width: 30%; background: var(--sunk); }
.cite {
  display: inline-block; margin-top: 3px; border: 0; background: var(--accent-soft); color: var(--accent); border-radius: 5px;
  padding: 1px 7px; font-size: 12px; font-family: var(--font-mono), var(--font-body); font-weight: 500; text-align: left;
}
.cite:hover { background: var(--accent); color: var(--accent-ink); }
.caution { font-size: 14px; color: var(--ink); background: var(--warn-soft); border-left: 3px solid var(--warn); padding: 8px 10px; border-radius: 6px; margin: 0; }
.note { font-size: 13px; color: var(--ink-2); border-left: 3px solid var(--line); padding-left: 10px; }
.soft { font-size: 13px; color: var(--ink-3); }
.more { display: grid; gap: 6px; }
details.box { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
.box.multi { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; display: grid; gap: 8px; background: var(--sunk); margin-top: 6px; }
.box.multi p { margin: 0; font-size: 14px; }
details.box summary { cursor: pointer; font-size: 13.5px; color: var(--ink-2); }
details.box[open] summary { margin-bottom: 8px; }
.feedback { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; border-top: 1px dashed var(--line); padding-top: 10px; }
.report { display: grid; gap: 8px; }
.report textarea { width: 100%; min-height: 96px; border: 1px solid var(--line); border-radius: 8px; padding: 8px; background: var(--paper); font-size: 13px; }

/* 계산기 */
.calc { background: var(--hl); border-radius: 10px; padding: 12px 14px; display: grid; gap: 10px; }
.calc h4 { margin: 0; font-size: 14px; font-weight: 600; }
.calc form { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: end; }
.calc label { display: grid; gap: 3px; font-size: 12.5px; color: var(--ink-2); }
.calc label.inline { display: flex; align-items: center; gap: 6px; }
.calc input[type=date], .calc input[type=number] { padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); min-width: 0; }
.calc input[type=number] { width: 80px; }
.calc table { width: 100%; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
.calc td { padding: 5px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
.calc td:first-child { color: var(--ink-2); width: 42%; padding-right: 10px; }
.calc .err { color: var(--danger); font-size: 13px; }

/* 되묻기·주제 목록 */
.cands { display: grid; gap: 8px; }
.lead { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line); display: grid; gap: 8px; }
.lead > .a { padding: 0; border: 0; box-shadow: none; background: transparent; }
.cand { text-align: left; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; padding: 10px 12px; display: grid; gap: 2px; }
.cand:hover { border-color: var(--accent); }
.cand b { font-weight: 600; }
.cand span { font-size: 13px; color: var(--ink-2); }
.cand-rule { font-style: normal; font-size: 11.5px; color: var(--accent); font-weight: 600; }
.hits { display: grid; gap: 8px; }
.hit { text-align: left; border: 0; border-left: 3px solid var(--line); background: transparent; padding: 4px 0 4px 10px; display: grid; gap: 2px; }
.hit:hover { border-left-color: var(--accent); }
.hit b { font-size: 13.5px; font-weight: 600; }
.hit span { font-size: 13px; color: var(--ink-2); }

/* 원문 칸 */
.source { min-width: 0; }
.source-inner {
  background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; display: grid; gap: 10px;
  position: sticky; top: calc(env(safe-area-inset-top, 0px) + 16px); max-height: calc(100vh - 32px); overflow: auto;
}
.source h2 { font-family: var(--font-display); font-size: 18px; margin: 0; }
.source .meta { font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.law { font-size: 14px; display: grid; gap: 6px; }
.law p { margin: 0; white-space: pre-wrap; }
.law p.para { padding: 4px 6px; border-radius: 6px; }
.law p.para.on { background: var(--hl); box-shadow: inset 3px 0 0 var(--accent); }
.law mark { background: var(--mark); color: var(--mark-ink); border-radius: 2px; padding: 0 1px; }
.law .tbl { overflow-x: auto; }
.law table { border-collapse: collapse; font-size: 12.5px; }
.law td, .law th { border: 1px solid var(--line); padding: 4px 6px; vertical-align: top; }
.close { display: none; }
.empty-source { color: var(--ink-3); font-size: 14px; }
@media (max-width: 999px) {
  .source { position: fixed; inset: auto 0 0 0; z-index: 20; padding: 0 max(8px, env(safe-area-inset-left, 0px)) env(safe-area-inset-bottom, 0px) max(8px, env(safe-area-inset-right, 0px)); }
  .source[data-open="false"] { display: none; }
  .source-inner { position: static; max-height: 78vh; border-radius: 14px 14px 0 0; box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.18); }
  .close { display: inline-block; justify-self: end; }
}

/* 검증 정보 */
.about { margin-top: 36px; border-top: 1px solid var(--line); padding-top: 18px; display: grid; gap: 12px; }
.about h3 { font-family: var(--font-display); font-size: 17px; margin: 0; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
.stat { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
.stat b { display: block; font-size: 20px; font-variant-numeric: tabular-nums; font-family: var(--font-mono), var(--font-body); }
.stat span { font-size: 12.5px; color: var(--ink-2); }
.about ul { margin: 0; padding-left: 18px; font-size: 13.5px; color: var(--ink-2); display: grid; gap: 4px; }
@media (prefers-reduced-motion: no-preference) { .turn { animation: rise 0.25s ease-out; } @keyframes rise { from { transform: translateY(6px); opacity: 0.6; } to { transform: none; opacity: 1; } } }
</style>

