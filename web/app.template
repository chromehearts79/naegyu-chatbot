    h("ul", null, [
      h("li", { text: "1단계 프로그램 검사: 인용한 조·항·호가 실제로 있는지, 인용 문구와 숫자가 원문과 같은지 확인했습니다." }),
      h("li", { text: "2단계 AI 재확인: 다른 AI 모델에 답을 숨긴 채 조문만 주고 같은 항목을 다시 찾게 해 비교했습니다. 결재권자 표는 프로그램으로 칸마다 대조했습니다." }),
      h("li", { text: "외부 법령 대조: 내규가 인용하거나 내규와 다른 법령 조문(남녀고용평등법, 근로기준법, 개인정보 보호법 등)을 국가법령정보로 확인했습니다(" + m.lawChecked + ")." }),
      h("li", { text: "3단계 담당부서 검수는 아직입니다. 검수를 마친 답에는 '담당부서 검수 완료'가 표시됩니다. 그 전까지는 중요한 결정 전에 원문을 보고 관련 부서에 문의하세요." }),
      h("li", { text: "시험 질문 정확도는 검색 기준값을 고를 때 같은 질문을 써서 실제보다 높게 나왔을 수 있습니다. 담당부서가 만든 질문으로 다시 재야 합니다." })
    ])
  );
  // 검수용 화면에서만 보인다(직원 화면에 null 을 넘기면 글자 'null'이 찍힌다)
  if (REVIEW && m.ruleFixes.length) $("#about").append(h("details", { class: "box" }, [h("summary", { text: "만들다 발견한 규정 정비 후보 " + m.ruleFixes.length + "건" }), h("ul", null, m.ruleFixes.map(function (t) { return h("li", { text: t }); }))]));
})();
// 화면 색: 자동(PC 설정을 따름)·밝게·어둡게. 고른 값은 이 PC의 브라우저에만 기억한다(저장이 막혀 있으면 이번에만)
(function () {
  var root = document.documentElement, btns = [].slice.call(document.querySelectorAll("#theme button"));
  function mark() {
    var cur = root.getAttribute("data-theme") || "auto";
    btns.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.choice === cur ? "true" : "false"); });
  }
  btns.forEach(function (b) {
    b.addEventListener("click", function () {
      var v = b.dataset.choice;
      if (v === "auto") root.removeAttribute("data-theme"); else root.setAttribute("data-theme", v);
      try { if (v === "auto") localStorage.removeItem("naegyu-theme"); else localStorage.setItem("naegyu-theme", v); } catch (e) {}
      mark();
    });
  });
  mark();
})();
// 다 열렸으니 '여는 중' 안내를 지운다
$("#loading").remove();
</script>
