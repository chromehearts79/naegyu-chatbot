<script>/*__ENGINE__*/</script>
<script>
"use strict";
var DATA = /*__DATA__*/;
var E = NaegyuEngine;
var cardIndex = new E.CardIndex(DATA.cards);
var byId = new Map(DATA.cards.map(function (c) { return [c.id, c]; }));
var rulesByName = new Map(DATA.rules.map(function (r) { return [r.name, r]; }));
var articleIndex = null;
function articles() { return articleIndex || (articleIndex = new E.ArticleIndex(DATA.rules)); }
var $ = function (sel, el) { return (el || document).querySelector(sel); };

function h(tag, attrs, kids) {
  var el = document.createElement(tag);
  if (attrs) Object.keys(attrs).forEach(function (k) {
    if (k === "class") el.className = attrs[k];
    else if (k === "text") el.textContent = attrs[k];
    else if (k.slice(0, 2) === "on") el.addEventListener(k.slice(2), attrs[k]);
    else if (attrs[k] !== undefined && attrs[k] !== null && attrs[k] !== false) el.setAttribute(k, attrs[k]);
  });
  (kids || []).forEach(function (k) { if (k !== null && k !== undefined) el.append(k.nodeType ? k : document.createTextNode(String(k))); });
  return el;
}
function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
// 답변 문단의 **굵게**만 살린다.
function rich(s) { var p = document.createElement("p"); p.innerHTML = esc(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>"); return p; }

/* ── 근거 조문 찾기 ───────────────────────────── */
var RE_ART = /^(.+?) (제\d+조(?:의\d+)?)(?:제(\d+)항)?(?:제(\d+)호)?(?:([가-힣])목)?$/;
function resolveCite(cite) {
  var m = /^(.+?) 부칙\(([\d.]+)\)$/.exec(cite);
  if (m) { var b = (DATA.buchik[m[1]] || {})[m[2]]; return b ? { rule: m[1], title: "부칙(" + m[2] + ")", text: b } : null; }
  m = /^(.+?) (별표.*)$/.exec(cite);
  if (m && m[2].indexOf("조") < 0) {
    var r0 = rulesByName.get(m[1]);
    var ax = r0 && r0.annexes.find(function (x) { return x.title.replace(/\s/g, "").indexOf(m[2].replace(/\s/g, "")) === 0; });
    return ax ? { rule: m[1], title: ax.title, text: ax.text, effective: r0.effective } : null;
  }
  m = RE_ART.exec(cite);
  if (!m) return null;
  var r = rulesByName.get(m[1]);
  var a = r && r.articles.find(function (x) { return x.no === m[2]; });
  return a ? { rule: m[1], no: a.no, title: a.no + "(" + a.title + ")", chapter: a.chapter, text: a.text, para: m[3] ? +m[3] : 0, item: m[4], effective: r.effective } : null;
}

var CIRCLED = "①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳";
// 표 HTML 은 우리 규정 변환본에서만 오지만, 그래도 표 태그와 칸 합치기 속성만 남긴다.
function safeTable(html) {
  return esc(html).replace(/&lt;(\/?)(table|tr|td|th|br)((?:\s+(?:rowspan|colspan)=&quot;\d+&quot;)*)\s*\/?&gt;/g, function (_, slash, tag, attrs) {
    return "<" + slash + tag + attrs.replace(/&quot;/g, '"') + ">";
  });
}
// 마크다운 표. 인용 문구가 한 줄(행)의 칸들을 이어 붙인 글에 있으면 그 행을 표시한다.
function pipeTable(lines, quote) {
  // 칸 구분(|)·띄어쓰기·가운뎃점 차이는 빼고 비교한다(인용이 "16 | 3,366,820 | 8"처럼 칸을 이어 적은 경우).
  var flat = function (t) { return t.replace(/<br>/g, "").replace(/[|\s]/g, "").replace(/[‧ㆍ∙･・]/g, "·"); };
  var q = flat(quote || ""), hit = false;
  var rows = lines.filter(function (l) { return !/^\|\s*-{3}/.test(l); }).map(function (l) {
    var cells = l.replace(/^\||\|$/g, "").split("|").map(function (c) { return c.trim(); });
    var on = q && flat(cells.join("")).indexOf(q) >= 0;
    if (on) hit = true;
    return "<tr>" + cells.map(function (c) {
      var inner = esc(c).replace(/&lt;br&gt;/g, "<br>");
      return "<td>" + (on ? "<mark>" + inner + "</mark>" : inner) + "</td>";
    }).join("") + "</tr>";
  });
  return { html: "<div class='tbl'><table>" + rows.join("") + "</table></div>", hit: hit };
}
// 인용 문구를 원문에서 찾아 표시한다. 띄어쓰기·가운뎃점 차이는 무시한다.
function markQuote(html, quote) {
  if (!quote) return html;
  // 한자 호환 글자(利 등)가 원문과 인용에서 다르게 들어간 경우가 있어 맞춘다
  html = html.normalize("NFC"); quote = quote.normalize("NFC");
  // 가운뎃점·따옴표·낫표는 원문마다 글자가 달라(·ㆍ・, "“, 「｢) 같은 것으로 본다. esc 뒤라 따옴표는 &quot; 로 바뀌어 있다.
  var parts = quote.replace(/[·‧ㆍ∙･・]/g, "·").replace(/[“”"]/g, "\u0001").replace(/[‘’']/g, "\u0002").split(/\s+/).filter(Boolean).map(function (w) {
    return esc(w).replace(/[.*+?^${}()|[\]\\]/g, "\\$&").replace(/·/g, "[·‧ㆍ∙･・]").replace(/[「｢]/g, "[「｢]").replace(/[」｣]/g, "[」｣]")
      .replace(/\u0001/g, "(?:[“”\"]|&quot;)").replace(/\u0002/g, "(?:[‘’']|&#39;)");
  });
  // 낱말 사이에 표 칸 안의 줄바꿈(<br>)이 끼어 있어도 찾는다.
  try { return html.replace(new RegExp("(" + parts.join("(?:\\s|<br\\s*/?>)*") + ")"), "<mark>$1</mark>"); } catch (e) { return html; }
}
function renderLaw(text, para, quote) {
  var blocks = [], cur = [], lines = text.split("\n");
  function flush() { if (cur.length) { blocks.push(cur.join("\n")); cur = []; } }
  for (var i = 0; i < lines.length; i++) {
    var l = lines[i];
    if (/^<table>/.test(l.trim())) {
      flush(); var t = [l];
      while (i + 1 < lines.length && !/<\/table>/.test(lines[i])) { i++; t.push(lines[i]); }
      var tableHtml = safeTable(t.join("")), markedHtml = markQuote(tableHtml, quote);
      blocks.push({ html: "<div class='tbl'>" + markedHtml + "</div>", hit: markedHtml !== tableHtml }); continue;
    }
    if (/^\|/.test(l.trim())) {
      flush(); var p = [l];
      while (i + 1 < lines.length && /^\|/.test(lines[i + 1].trim())) { i++; p.push(lines[i]); }
      blocks.push(pipeTable(p, quote)); continue;
    }
    if (l.trim() === "") { flush(); continue; }
    if (CIRCLED.indexOf(l.trim()[0]) >= 0) flush();
    cur.push(l);
  }
  flush();
  var box = h("div", { class: "law" }), marked = false, target = null;
  blocks.forEach(function (b) {
    if (typeof b !== "string") {
      var d = document.createElement("div"); d.innerHTML = b.html; box.append(d);
      // 긴 별표(표)는 표 가운데로 굴리면 표시한 줄이 칸 밖에 숨으므로 표시한 글자로 굴린다
      if (b.hit && !marked) { marked = true; target = target || d.querySelector("mark") || d; }
      return;
    }
    var n = CIRCLED.indexOf(b.trim()[0]) + 1, el = h("p", { class: n ? "para" : "" });
    var html = esc(b), on = para && n === para;
    if (on || (!para && !marked)) {
      var m2 = markQuote(html, quote);
      if (m2 !== html) { marked = true; html = m2; if (!target) target = el; }
    }
    if (on) { el.classList.add("on"); target = el; }
    el.innerHTML = html; box.append(el);
  });
  if (!marked && quote) box.querySelectorAll("p").forEach(function (p) {
    if (marked) return;
    var m3 = markQuote(p.innerHTML, quote);
    if (m3 !== p.innerHTML) { p.innerHTML = m3; marked = true; target = target || p; }
  });
  // 인용이 "가. 강등 … 나. 정직 …"처럼 여러 줄에 걸치면 목(가·나·다)마다 나눠 각각 표시한다.
  if (!marked && quote && /\s[가-하]\.\s/.test(quote)) quote.split(/\s(?=[가-하]\.\s)/).forEach(function (seg) {
    box.querySelectorAll("p").forEach(function (p) {
      var m4 = markQuote(p.innerHTML, seg);
      if (m4 !== p.innerHTML) { p.innerHTML = m4; marked = true; target = target || p; }
    });
  });
  return { box: box, target: target };
}

function openSource(cite, quote) {
  var src = $("#source"), inner = $("#source-inner"), r = resolveCite(cite);
  inner.replaceChildren($("#source-close") || closeBtn());
  if (!r) { inner.append(h("p", { class: "empty-source", text: "원문을 찾지 못했습니다: " + cite })); }
  else {
    var law = renderLaw(r.text, r.para, quote), fb = r.no ? formBox(formsAt(r.rule, r.no)) : null;
    inner.append(
      h("div", { class: "label", text: "근거 조문 원문" }),
      h("h2", { text: r.rule + " " + r.title }),
      h("div", { class: "meta", text: [r.chapter, r.effective ? "현행 시행 " + r.effective : "", "인용: " + cite].filter(Boolean).join(" · ") }),
      law.box
    );
    if (fb) inner.append(fb);
    if (law.target) setTimeout(function () { law.target.scrollIntoView({ block: "center", behavior: "smooth" }); }, 30);
  }
  setSource(true);
  if (window.matchMedia("(max-width: 999px)").matches) inner.scrollTop = 0;
}
// 원문 칸 열고 닫기(넓은 화면에서는 열 때만 오른쪽 칸이 생긴다)
function setSource(open) { $("#source").dataset.open = open ? "true" : "false"; $(".wrap").classList.toggle("reading", open); }
function closeBtn() { return h("button", { class: "btn ghost close", type: "button", id: "source-close", text: "닫기", onclick: function () { setSource(false); } }); }
